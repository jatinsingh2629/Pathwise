# .env.example — copy to .env and edit

# Flask
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database (default: SQLite)
# For PostgreSQL: postgresql://user:password@localhost/pathwise_db
DATABASE_URL=sqlite:///instance/learning_path.db

# BERT Model (default: all-MiniLM-L6-v2, fast & accurate)
BERT_MODEL_NAME=all-MiniLM-L6-v2
